# ── AWS ──────────────────────────────────────────────────────────────────
# If deploying on AWS itself (ECS, Lambda, EC2) with an
# IAM role attached, omit AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY entirely
# — the SDK picks up the role's credentials automatically. Only set them
# for local dev against a real IAM *user* (never commit real values here —
# this file is a template; your actual .env.local is gitignored).
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for cover/avatar photo uploads.
S3_BUCKET=profile-card-photos-cluster

# MongoDB connection string. In AWS this is injected from SSM Parameter
# Store (/cluster-app/mongodb-uri, a SecureString) by the ECS task
# definition — never paste the real credentialled URI into this file.
# Local dev against a throwaway container:
#   docker run -d -p 27017:27017 mongo:7
MONGODB_URI=mongodb://localhost:27017/clusterapp
MONGODB_DB=clusterapp
MONGODB_COLLECTION=profiles

# ── CORS ────────────────────────────────────────────────────────────────
# The exact origin your static index.html/app.js is served from (e.g. your
# S3 static website / CloudFront / the ALB DNS name). Must be an exact
# origin, not '*', now that requests carry an Authorization header.
ALLOWED_ORIGIN=http://localhost:8080

# ── Cognito ─────────────────────────────────────────────────────────────
# From the Cognito console.
COGNITO_USER_POOL_ID=us-west-1_REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
